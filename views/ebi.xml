<odoo>
    <data>
        <record id="view_ebi_database_form" model="ir.ui.view">
            <field name="name">EBI Data Wizard (XML-RPC)</field>
            <field name="model">ebi.database</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="name"/>
                        <notebook>
                            <page string="Database Credentials">
                                <group>
                                    <group string="Source">
                                        <field name="source_address"/>
                                        <field name="source_database"/>
                                        <field name="source_email"/>
                                        <field name="source_uid"/>
                                        <field name="source_pass" password="True"/>
                                    </group>
                                    <group string="Target">
                                        <field name="target_address"/>
                                        <field name="target_database"/>
                                        <field name="target_email"/>
                                        <field name="target_uid"/>
                                        <field name="target_pass" password="True"/>
                                    </group>
                                    <button name="update_khan_store_bd_state" class="btn-primary" string="update_khan_store_bd_state" type="object"/>
                                    <button name="delete_previous_data" class="btn-primary" string="delete_previous_data" type="object"/>
                                    <button name="delete_previous_product_data" class="btn-primary" string="delete_product_data" type="object"/>
                                </group>
                            </page>
                            <page string="Postgre Sql Credentials">
                                <group>
                                    <group string="Source">
                                        <field name="source_pg_host"/>
                                        <field name="source_pg_port"/>
                                        <field name="source_pg_user"/>
                                        <field name="source_pg_pass" password="True"/>
                                    </group>
                                    <group string="Target">
                                        <field name="target_pg_host"/>
                                        <field name="target_pg_port"/>
                                        <field name="target_pg_user"/>
                                        <field name="target_pg_pass" password="True"/>
                                    </group>
                                    <button type="object" name="update_table_list" string="update_table_list" class="btn-primary"/>
                                    <button type="object" name="update_all_sequences" string="update_all_sequences" class="btn-primary"/>
                                </group>
                            </page>
                            <page string="Tables">
                                <group>
                                    <field name="model_ids" >
                                        <tree >
                                            <field name="selected" />
                                            <field name="sequence" widget="handle"/>
                                            <field name="sequence" />
                                            <field name="no_id"/>
                                            <field name="name"/>
                                            <field name="database_id"/>
                                            <field name="source"/>
                                            <field name="target"/>
                                            <button name="import_table_data" type="object" string="import_table_data" class="btn-primary"/>
                                            <button name="import_table_data_with_related" type="object" string="import data_with_related" class="btn-primary"/>

                                        </tree>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                        <group string="Operation Type">
                                    <group>
                                        <field name="export_type"/>
                                        <field name="download_path"/>
                                        <button name="export_jsondata" string="import json fields" type="object"
                                                class="btn-primary"/>
                                        <button name="direct_db_db_export" string="Direct export Db2DB" type="object"
                                                class="btn-primary"/>
                                        <button name="fetch_data_with_external_ids"
                                                string="fetch_data_with_external_ids" type="object"
                                                class="btn-primary"/>
                                        <button name="test_source_connection" string="test_source_connection"
                                                type="object" class="btn-primary"/>
                                        <button name="export_data" string="Export" type="object" class="btn-primary"/>
                                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                                    </group>
                                </group>
                        <!--<group> <field name="model_ids"/>
                         <field name="field_ids"  domain="[('model_id', '=', model_id)]">
                             <tree>
                                 <field name="name"/>
                                 <field name="model_id"/>
                                 <field name="source"/>
                                 <field name="target"/>
                             </tree>
                         </field>

                     </group>-->

                    </sheet>
                    <footer>
                    </footer>
                </form>
            </field>
        </record>
        <record id="ebi_fields_tree" model='ir.ui.view'>
            <field name="name">ebi.fields.tree</field>
            <field name="model">ebi.fields</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" widget="handle"/>
                    <field name="name" />
                    <field name="selected" />
                    <field name="model_id" />
                    <field name="source" />
                    <field name="target" />
                    <field name="default_value" />
                    <field name="data_type" />
                </tree>
            </field>
        </record>
         <record id="view_ebi_database_tree" model="ir.ui.view">
            <field name="name">EBI Data Wizard (XML-RPC)</field>
            <field name="model">ebi.database</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="source_database"/>
                    <field name="target_database"/>
                </tree>
            </field>
        </record>

        <record id="ebi_model_form" model='ir.ui.view'>
            <field name="name">ebi.model.form</field>
            <field name="model">ebi.model</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="sequence" />
                                <field name="name" />
                                <field name="selected" />
                                <field name="no_id" />
                                <field name="database_id" />
                                <field name="source" />
                                <field name="target" />
                            </group>
                            <group>

                                <button name="update_field_list" string="update_field_list" type="object" class="btn-primary"/>
                            </group>

                        </group>
                        <group>
                                <field name="field_ids" >
                                    <tree editable="top">
                                        <field name="selected"/>
                                        <field name="model_id"/>
                                        <field name="name"/>
                                        <field name="source"/>
                                        <field name="target"/>
                                        <field name="default_value"/>
                                        <field name="data_type"/>
                                    </tree>
                                </field>
                            </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ebi_model_tree" model='ir.ui.view'>
            <field name="name">ebi.model.tree</field>
            <field name="model">ebi.model</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" widget="handle"/>
                    <field name="name" />
                    <field name="selected" />
                    <field name="database_id" />
                    <field name="source" />
                    <field name="target" />
                    <field name="field_ids" />
                </tree>
            </field>
        </record>
    </data>
</odoo>